# Application
PROJECT_NAME=FastAPI Multi-Tenant App
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_super_secret_key_in_production_min_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multitenant_db

# Or specify a full connection string directly:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multitenant_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# Google Gemini & Embeddings
# GEMINI_API_KEY=AIzaSy...
EMBEDDING_MODEL=text-embedding-004

